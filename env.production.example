# نسخة الإنتاج من متغيرات البيئة
# انسخ هذا الملف إلى .env.production وقم بتعديل القيم

# إعدادات الخادم
NODE_ENV=production
PORT=80
HOST=0.0.0.0
DOMAIN=cor-toba.online

# Google Sheets API
# احصل على المفتاح من: https://console.cloud.google.com/
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
GOOGLE_SHEETS_ID=1GYlz87nWa7q0W8KD7QuqiR-GCzu3C2KRmCGnYOCKZEg

# DeepSeek API للذكاء الاصطناعي
# احصل على المفتاح من: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Telegram Bot
# احصل على التوكن من: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Session Secret (مهم جداً للأمان!)
# قم بتوليد مفتاح عشوائي قوي (32 حرف على الأقل)
# يمكنك استخدام: https://randomkeygen.com/
SESSION_SECRET=generate_a_very_strong_random_secret_key_here_minimum_32_characters

# قاعدة البيانات PostgreSQL (اختياري)
# إذا كنت تريد استخدام قاعدة بيانات بدلاً من Google Sheets
DATABASE_URL=postgresql://username:password@localhost:5432/cortoba

# إعدادات البريد الإلكتروني (اختياري)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# إعدادات الأمان
CORS_ORIGIN=https://cor-toba.online
SECURE_COOKIES=true
TRUST_PROXY=true

# حدود الرفع
MAX_FILE_SIZE=10485760  # 10MB
MAX_FILES=10

# معدل المزامنة (بالثواني)
SYNC_INTERVAL=10

# مسارات الملفات
UPLOAD_PATH=./uploads
LOG_PATH=./logs

# وضع التطوير (false للإنتاج)
DEBUG_MODE=false