# نموذج ملف البيئة - انسخ هذا الملف إلى .env وأضف القيم الفعلية
# Copy this file to .env and add your actual values

# ===============================
# إعدادات أساسية (مطلوبة)
# ===============================

# إعدادات Google Sheets (مطلوب)
GOOGLE_SHEETS_ID=1pLFZIa-nXdRJqP4Hvgcof_nhv6uqZxOCHKhc_qacSvs
GOOGLE_USERS_SHEETS_ID=1GYlz87nWa7q0W8KD7QuqiR-GCzu3C2KRmCGnYOCKZEg

# مفتاح DeepSeek AI (مطلوب للتحليل الذكي)
DEEPSEEK_API_KEY=sk-975df6f825c24e91bc60de32c35b59ce

# مفتاح الجلسة (استخدم نص عشوائي طويل - 64 حرف على الأقل)
SESSION_SECRET=6536a28e5aaf1e3ec09febf95d310ba13463027a4ad64e016ad9dd6b8e1b5d9d

# ===============================
# إعدادات الخادم
# ===============================

# منفذ الخادم
PORT=5000

# بيئة العمل (development أو production)
NODE_ENV=development

# ===============================
# إعدادات اختيارية
# ===============================

# إعدادات قاعدة البيانات PostgreSQL (اختياري - النظام يعمل بدونها)
# DATABASE_URL=postgresql://username:password@localhost:5432/qortoba_db

# إعدادات Telegram Bot (اختياري)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# إعدادات الأمان (اختيارية)
TRUST_PROXY=false

# إعدادات CORS (اختيارية)
CORS_ORIGIN=http://localhost:5000

# مدة انتهاء الجلسة (بالثواني) - افتراضي: 24 ساعة
SESSION_MAX_AGE=86400

# إعدادات تسجيل الأخطاء
LOG_LEVEL=info

# إعدادات النسخ الاحتياطي
BACKUP_RETENTION_DAYS=30

# إعدادات الملفات المرفوعة
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.xlsx,.xls,.csv,.txt

# ===============================
# ملاحظات مهمة
# ===============================
# 1. ملف google-service-account-key.json مطلوب في المجلد الرئيسي
# 2. تأكد من منح صلاحيات للبريد الإلكتروني cortoba-sys@cortoba-supp-sys.iam.gserviceaccount.com في Google Sheets
# 3. قاعدة البيانات اختيارية - النظام يعمل مع Google Sheets فقط
